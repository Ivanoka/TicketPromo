
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
	
	<AssemblyName>Ticket Promo</AssemblyName>

    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

	<ApplicationIcon>icon.ico</ApplicationIcon>

	<Authors>Иван Титов</Authors>
	<Version>2026.11.06.1</Version>
	<Description>Автоматическая печать рекламных материалов после завершения пользовательских заданий печати.</Description>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

	<DebugType>none</DebugType>
	<DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
	<None Update="icon.ico">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</None>
  </ItemGroup>
  <ItemGroup>
    <None Update="LICENSE">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</None>
  </ItemGroup>

</Project>
